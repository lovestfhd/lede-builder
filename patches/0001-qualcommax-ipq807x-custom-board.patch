+	ucidef_set_led_netdev "sfp1-activity" "SFP1 (Activity)" "green:sfp1-act" "lan5" "tx rx"
+	ucidef_set_led_netdev "sfp2-activity" "SFP2 (Activity)" "green:sfp2-act" "lan6" "tx rx"
+	;;
 netgear,rax120v2)
 	ucidef_set_led_netdev "aqr" "AQR" "white:aqr" "lan5"
 	;;
diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
index b3f9741e..9e87e3e5 100644
--- a/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/board.d/02_network
@@ -57,6 +57,9 @@ ipq807x_setup_interfaces()
 	zyxel,nbg7815)
 		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 10g" "wan"
 		;;
+	tplink,tl-er2260t)
+		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4 lan5" "lan6"
+		;;
 	*)
 		echo "Unsupported hardware. Network interfaces not initialized"
 		;;
@@ -76,6 +79,13 @@ ipq807x_setup_macs()
 		lan_mac=$(macaddr_add "$wan_mac" 1)
 		label_mac="$wan_mac"
 		;;
+	tplink,tl-er2260t)
+		lan_mac=$(mtd_get_mac_binary "0:ethphyfw" 0x0)
+		wan_mac=$(mtd_get_mac_binary "0:ethphyfw" 0x6)
+		[ -z "$lan_mac" ] && lan_mac=$(mtd_get_mac_binary "0:art" 0x0)
+		[ -z "$wan_mac" ] && wan_mac=$(macaddr_add "$lan_mac" 1)
+		label_mac="$lan_mac"
+		;;
 	esac
 
 	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/init.d/sfp_link_speed b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/sfp_link_speed
new file mode 100755
index 00000000..39d1b129
--- /dev/null
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/sfp_link_speed
@@ -0,0 +1,91 @@
+#!/bin/sh /etc/rc.common
+
+START=15
+STOP=90
+
+USE_PROCD=1
+
+# SFP 接口名与 SSDK 端口号的对应关系（来自 DTS 的 port_id）：
+#   lan5 = dp6_syn = SSDK port 6
+#   lan6 = dp5_syn = SSDK port 5
+sfp_port() {
+	case "$1" in
+	lan5) echo 6 ;;
+	lan6) echo 5 ;;
+	*) return 1 ;;
+	esac
+}
+
+# 用户配置的 sfp_speed 到 SSDK SerDes 模式的映射：
+#   1   -> sgmii_fiber (1G)
+#   2   -> sgmii_plus  (2.5G / HSGMII)
+#   10  -> 10gbase_r   (10G)
+#   空   -> 10gbase_r   (默认，兼容 LuCI 空值表示 10G)
+sfp_mode() {
+	case "$1" in
+	1) echo sgmii_fiber ;;
+	2) echo sgmii_plus ;;
+	10|'') echo 10gbase_r ;;
+	*) return 1 ;;
+	esac
+}
+
+# 加入待处理列表；同一端口只记录一次，避免重复 set。
+sfp_pending_add() {
+	case " $sfp_pending " in
+	*" $1:"*) return 0 ;;
+	esac
+	sfp_pending="$sfp_pending $1:$2"
+}
+
+sfp_speed_device_cb() {
+	local name speed port mode
+
+	config_get name "$1" name
+	[ -n "$name" ] || name="$1"
+	[ -n "$name" ] || return 0
+
+	port=$(sfp_port "$name") || return 0
+	config_get speed "$1" sfp_speed
+	mode=$(sfp_mode "$speed") || return 0
+
+	sfp_pending_add "$port" "$mode"
+}
+
+start_service() {
+	[ "$(board_name)" = "tplink,tl-er2260t" ] || return 0
+
+	sfp_pending=""
+	config_load network
+	config_foreach sfp_speed_device_cb device
+
+	# 兜底：未显式配置的 SFP 端口默认强制 10G，避免 host-side 链路起不来。
+	for port in 5 6; do
+		sfp_pending_add "$port" 10gbase_r
+	done
+
+	local entry port mode applied=0
+
+	for entry in $sfp_pending; do
+		port=${entry%%:*}
+		mode=${entry#*:}
+		if ssdk_sh port interfaceMode set "$port" "$mode" >/dev/null 2>&1; then
+			logger -t "SFP Speed" "Set SSDK port $port to $mode."
+			applied=1
+		else
+			logger -t "SFP Speed" "Failed to set SSDK port $port to $mode."
+		fi
+	done
+
+	[ "$applied" -eq 1 ] || return 0
+
+	if ssdk_sh port interfaceMode apply >/dev/null 2>&1; then
+		logger -t "SFP Speed" "Interface mode applied."
+	else
+		logger -t "SFP Speed" "Failed to apply interface mode."
+	fi
+}
+
+service_triggers() {
+	procd_add_reload_trigger network
+}
